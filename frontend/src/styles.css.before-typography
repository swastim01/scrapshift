:root {
  font-family: 'DM Sans', sans-serif;
  color: #21352d;
  background: #f7f8f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --forest: #163b30;
  --forest-deep: #102e25;
  --forest-mid: #235743;
  --green: #2d7b62;
  --mint: #dff0e6;
  --ink: #20352d;
  --muted: #7e8c84;
  --line: #e8ece7;
  --paper: #ffffff;
  --canvas: #f7f8f5;
  --amber: #b77b2e;
  --red: #b85e4a;
  --shadow: 0 5px 25px rgba(35, 58, 46, 0.035);
}

* { box-sizing: border-box; }
html, body, #root { min-height: 100%; margin: 0; }
body { background: var(--canvas); font-family: 'DM Sans', sans-serif; font-size: 13px; color: var(--ink); }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
button:disabled { opacity: .58; cursor: not-allowed !important; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid rgba(45,123,98,.22); outline-offset: 2px; }
::selection { background: #d0e9db; color: #173b2e; }

/* App frame */
.app-shell { min-height: 100vh; display: flex; background: var(--canvas); }
.app-sidebar { width: 252px; min-width: 252px; height: 100vh; background: #fff; border-right: 1px solid #e9ede8; display: flex; flex-direction: column; padding: 25px 16px 17px; position: sticky; top: 0; z-index: 20; }
.brand-lockup { display: flex; align-items: center; gap: 10px; padding: 0 9px; min-height: 43px; }
.brand-mark { width: 38px; height: 38px; border-radius: 12px; background: var(--forest); display: grid; place-items: center; color: #d8f2dd; box-shadow: 0 5px 13px rgba(22,59,48,.14); flex: 0 0 auto; }
.brand-wordmark { display: flex; flex-direction: column; gap: 2px; line-height: 1; }
.brand-wordmark strong { font-family: 'Manrope', sans-serif; font-size: 15px; letter-spacing: .09em; font-weight: 800; color: #173c30; }
.brand-wordmark strong span { font-size: 7px; vertical-align: top; margin-left: 2px; }
.brand-wordmark small { font-size: 8px; letter-spacing: .18em; color: #829087; font-weight: 700; margin-top: 4px; }
.workspace-switch { display: flex; align-items: center; gap: 9px; border: 1px solid #e9eee8; border-radius: 11px; margin: 29px 2px 28px; padding: 10px 9px; min-width: 0; }
.workspace-avatar { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; font-family: 'Manrope', sans-serif; font-weight: 800; color: #fff; background: linear-gradient(140deg, #d3a26d, #926341); box-shadow: inset 0 0 0 1px rgba(255,255,255,.2); flex: 0 0 auto; }
.workspace-name { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 5px; }
.workspace-name strong { font-size: 11px; font-weight: 700; color: #33443b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.workspace-name span { color: #87948b; font-size: 9px; display: flex; align-items: center; gap: 5px; }
.workspace-name span i, .last-updated span, .topbar-ai-status span, .sidebar-help-row + .sidebar-footer span:before { display: inline-block; width: 6px; height: 6px; background: #55a77c; border-radius: 50%; }
.workspace-switch > svg { color: #97a39b; flex: 0 0 auto; }
.sidebar-nav { display: flex; flex-direction: column; gap: 4px; }
.nav-group-label { padding: 0 12px; margin-bottom: 9px; color: #a0aaa3; font-weight: 700; letter-spacing: .12em; font-size: 9px; }
.nav-group-spaced { margin-top: 27px; }
.sidebar-nav-item { display: flex; align-items: center; position: relative; gap: 12px; width: 100%; background: transparent; border: 0; border-radius: 9px; color: #7d8982; padding: 11px 12px; text-align: left; font-weight: 600; font-size: 12px; transition: color .18s ease, background .18s ease; }
.sidebar-nav-item > svg { color: #8c9b91; flex: 0 0 auto; }
.sidebar-nav-item span:not(.nav-new-mark):not(.nav-active-line) { flex: 1; }
.sidebar-nav-item:hover { color: var(--forest); background: #f5f8f5; }
.sidebar-nav-item.nav-active { background: #eaf4ed; color: #1d573f; font-weight: 700; }
.sidebar-nav-item.nav-active > svg { color: #327454; }
.sidebar-nav-item.nav-active::before { content: ''; position: absolute; left: -16px; top: 9px; bottom: 9px; width: 3px; border-radius: 0 3px 3px 0; background: #3e8a65; }
.nav-count { margin-left: auto; border-radius: 6px; padding: 3px 6px; color: #718078; background: #f1f4f1; font-size: 10px; }
.sidebar-nav-item.nav-active .nav-count { color: #286545; background: #d5e9dc; }
.nav-accent { margin-top: 5px; background: #f5f9f5; border: 1px solid #e7f0e7; color: #4d765f; }
.nav-accent > svg { color: #4d8b68; }
.nav-new-mark { font-size: 8px; color: #3c835e; background: #e0f0e4; border-radius: 4px; padding: 3px 5px; letter-spacing: .04em; font-weight: 800; }
.sidebar-bottom { margin-top: auto; }
.sidebar-impact-widget { margin: 10px 2px 21px; border-radius: 12px; color: #fff; background: radial-gradient(circle at 100% 0%, rgba(94,143,111,.34), transparent 45%), linear-gradient(145deg, #1a4b3a, #143629); padding: 16px 15px 13px; position: relative; overflow: hidden; }
.sidebar-impact-widget:after { content: ''; position: absolute; right: -25px; bottom: 5px; width: 94px; height: 94px; border: 1px solid rgba(208,238,216,.12); border-radius: 50%; box-shadow: 0 0 0 14px rgba(208,238,216,.025), 0 0 0 29px rgba(208,238,216,.025); pointer-events: none; }
.widget-leaf-mark { color: #b8e2c2; margin-bottom: 10px; }
.widget-label { font-size: 8px; letter-spacing: .14em; color: #b1cdb9; font-weight: 700; margin-bottom: 5px; }
.sidebar-impact-widget > strong { font-family: 'Manrope', sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -.04em; display: block; line-height: 1.2; }
.sidebar-impact-widget > strong small { font-size: 12px; color: #b5d6c0; font-weight: 600; }
.widget-sub { color: #aec9b6; font-size: 9px; margin-top: 5px; }
.sidebar-impact-widget button { display: flex; align-items: center; gap: 5px; margin-top: 13px; padding: 0; border: 0; background: transparent; color: #e0f3e3; font-size: 10px; font-weight: 700; position: relative; z-index: 1; }
.sidebar-help-row { display: flex; align-items: center; gap: 10px; padding: 0 7px 17px; }
.help-bubble { width: 30px; height: 30px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 9px; background: #f0f4ef; color: #7c8a80; }
.sidebar-help-row strong { display: block; color: #4b5e52; font-size: 10px; margin-bottom: 3px; }
.sidebar-help-row button { font-size: 9px; color: #8b9990; background: none; border: 0; padding: 0; }
.sidebar-help-row button:hover { color: #2e6c4c; }
.sidebar-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f0f2ee; padding: 13px 8px 0; color: #a0aaa2; font-size: 8px; letter-spacing: .03em; }
.sidebar-footer button { border: 0; padding: 2px 0; color: #a0aaa2; background: none; font-size: 9px; }
.sidebar-footer button:hover { color: #47765a; }
.app-main { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.app-topbar { min-height: 70px; height: 70px; background: rgba(255,255,255,.94); border-bottom: 1px solid #e9ede8; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 15; backdrop-filter: blur(14px); }
.topbar-breadcrumb { display: flex; align-items: center; gap: 10px; font-size: 11px; color: #9aa59d; white-space: nowrap; }
.topbar-breadcrumb strong { color: #384b40; font-weight: 700; }
.breadcrumb-divider { color: #c7cec8; }
.sync-indicator { display: inline-flex; gap: 4px; align-items: center; color: #4f8a68; font-size: 9px; margin-left: 5px; }
.sync-indicator svg { animation: spin 1.2s linear infinite; }
.topbar-actions { display: flex; align-items: center; gap: 12px; }
.topbar-search-button { min-width: 217px; height: 35px; display: flex; gap: 8px; align-items: center; padding: 0 9px; border: 1px solid #e8ece7; background: #fafbf9; border-radius: 8px; color: #9aa49d; text-align: left; }
.topbar-search-button span { flex: 1; font-size: 10px; }
.topbar-search-button kbd { color: #9ba69e; border: 1px solid #e4e8e3; border-radius: 4px; background: #fff; padding: 2px 4px; font-size: 8px; font-family: 'DM Sans', sans-serif; }
.topbar-search-button:hover, .topbar-search-button.search-is-open { border-color: #b5d3bf; background: #fff; color: #467a5b; }
.topbar-icon-button { border: 1px solid #e7ede6; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 9px; background: white; color: #6e8a75; }
.topbar-icon-button:hover { background: #eef5ef; border-color: #d6e7d9; color: #2c6a49; }
.topbar-ai-status { display: flex; align-items: center; gap: 6px; color: #85928a; font-size: 9px; white-space: nowrap; }
.topbar-ai-status span { background: #d4a45e; width: 6px; height: 6px; }
.topbar-ai-status.ai-connected span { background: #4eaa75; }
.topbar-avatar { width: 32px; height: 32px; display: grid; place-items: center; font-size: 10px; font-weight: 800; color: #a47649; border: 2px solid #fff; border-radius: 50%; background: #f3e2cf; box-shadow: 0 0 0 1px #eadbcb; margin-left: 1px; }
.app-content { padding: 27px 32px 24px; width: 100%; max-width: 1720px; margin: 0 auto; flex: 1; min-width: 0; }
.app-footer { display: flex; align-items: center; justify-content: space-between; padding: 0 32px 17px; color: #a3ada5; font-size: 9px; letter-spacing: .02em; gap: 12px; }
.app-footer > span:nth-child(2) { display: flex; align-items: center; gap: 6px; }
.app-footer > span:nth-child(2) i { width: 5px; height: 5px; border-radius: 50%; background: #79b18c; }
.app-footer button { border: 0; padding: 0; display: flex; align-items: center; gap: 4px; color: #7a9381; background: none; font-size: 9px; }
.app-footer button:hover { color: #235f40; }
.app-loading { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f7f8f5; color: #4b6355; }
.loading-brand { display: flex; align-items: center; gap: 10px; font-family: 'Manrope', sans-serif; font-weight: 800; letter-spacing: .12em; font-size: 15px; color: #173e30; margin-bottom: 49px; }
.loading-spinner { color: #39805c; animation: spin 1.5s linear infinite; margin-bottom: 17px; }
.app-loading h2 { font-family: 'Manrope', sans-serif; font-size: 20px; font-weight: 700; letter-spacing: -.03em; margin-bottom: 8px; }
.app-loading p { font-size: 12px; color: #8a978d; }
.loading-track { width: 230px; background: #e4ebe4; border-radius: 9px; height: 4px; overflow: hidden; margin-top: 22px; }
.loading-track span { display: block; width: 40%; height: 100%; background: #3d855f; border-radius: 9px; animation: loading-slide 1.5s ease-in-out infinite; }
@keyframes loading-slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(350%); } }
@keyframes spin { to { transform: rotate(360deg); } }
.spin { animation: spin 1s linear infinite; }

/* Shared components */
.page-stack { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
.page-intro-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 18px; margin-bottom: 1px; }
.eyebrow { color: #8d9c91; font-size: 9px; line-height: 1.25; font-weight: 800; letter-spacing: .15em; margin-bottom: 8px; }
.page-intro-row h1 { font-family: 'Manrope', sans-serif; font-size: 27px; letter-spacing: -.045em; color: #203a2d; line-height: 1.25; font-weight: 800; margin: 0 0 7px; }
.page-intro-row p { color: #87948b; max-width: 680px; line-height: 1.6; margin: 0; font-size: 11px; }
.btn { font-size: 11px; font-weight: 700; border-radius: 8px; padding: 9px 13px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; box-shadow: none !important; }
.btn-sm { padding: 7px 9px; font-size: 10px; border-radius: 7px; }
.btn-forest { background: #1c543f; color: #fff; border: 1px solid #1c543f; transition: background .18s, transform .18s, box-shadow .18s; }
.btn-forest:hover { background: #113f2e; color: #fff; border-color: #113f2e; transform: translateY(-1px); box-shadow: 0 5px 13px rgba(25,80,59,.13) !important; }
.btn-forest:active { transform: translateY(0); }
.btn-outline-forest { background: #fff; border: 1px solid #cbdccf; color: #276247; }
.btn-outline-forest:hover { background: #f1f7f1; color: #194d36; border-color: #a7cbb3; }
.btn-light { background: #f5f7f4; border: 1px solid #edf0eb; color: #66766b; }
.btn-light:hover { background: #eef4ee; color: #335d43; border-color: #dbe7dc; }
.btn-white { background: #fff; color: #204b37; border: 1px solid #fff; }
.btn-white:hover { background: #eaf5ed; border-color: #eaf5ed; color: #17422e; transform: translateY(-1px); }
.panel-card { border: 1px solid #e8ece7; border-radius: 13px; background: #fff; box-shadow: var(--shadow); }
.muted-copy { font-size: 11px; color: #8c9890; }
.muted-inline { color: #98a49b; font-size: 9px; font-weight: 500; margin-left: 4px; }
.form-label { color: #66766c; font-weight: 700; font-size: 10px; margin-bottom: 6px; }
.form-control, .form-select { min-height: 38px; border-radius: 8px; border-color: #e2e8e1; color: #34473b; font-size: 11px; box-shadow: none !important; }
.form-control::placeholder { color: #b0b9b2; }
.form-control:focus, .form-select:focus { border-color: #a4c9ae; box-shadow: 0 0 0 3px rgba(46,129,85,.08) !important; }
.form-control[readonly] { background: #f7f8f6; }
.section-heading { display: flex; align-items: center; gap: 11px; margin-bottom: 19px; }
.section-heading h3 { margin: 0 0 4px; font-size: 13px; font-family: 'Manrope', sans-serif; font-weight: 800; letter-spacing: -.02em; color: #2a4234; }
.section-heading p { margin: 0; color: #93a097; font-size: 10px; line-height: 1.5; }
.section-icon { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; flex: 0 0 auto; }
.mint-icon { background: #e5f2e8; color: #3f835b; }
.blue-icon { background: #e8f1f7; color: #4c7e9c; }
.amber-icon { background: #fbf0df; color: #b07b35; }
.violet-icon { background: #f0eafa; color: #8766ac; }
.green-icon { background: #e4f3e8; color: #367b55; }
.status-pill { display: inline-flex; align-items: center; gap: 4px; border-radius: 6px; padding: 4px 7px; font-size: 9px; font-weight: 700; white-space: nowrap; line-height: 1.2; }
.pill-verified { color: #34734e; background: #e8f5ea; }
.pill-testing { color: #9a6d2d; background: #fcf1df; }
.pill-unverified { color: #7b8880; background: #edf1ed; }
.pill-quarantine { color: #9c4c3e; background: #fbece8; }
.pill-missing { color: #9d6c3b; background: #fbefdf; }
.pill-demo { color: #7560a5; background: #f1ebfb; }
.tiny-link { display: inline-flex; align-items: center; gap: 4px; padding: 2px 0; border: 0; color: #518164; background: transparent; font-size: 10px; font-weight: 700; white-space: nowrap; }
.tiny-link:hover { color: #214e34; }
.card-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.card-heading-row h3 { font-family: 'Manrope', sans-serif; font-size: 14px; font-weight: 800; letter-spacing: -.025em; margin: 0 0 5px; color: #2b4435; }
.card-heading-row p { color: #929e95; font-size: 10px; margin: 0; line-height: 1.5; }
.card-heading-row .eyebrow { margin-bottom: 7px; }
.page-loading { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 100px 0; color: #73907c; font-size: 12px; }
.page-loading svg { animation: spin 1s linear infinite; }

/* Dashboard */
.dashboard-page { gap: 19px; }
.dashboard-hero { display: flex; min-height: 305px; border-radius: 17px; overflow: hidden; background: radial-gradient(ellipse at 87% 18%, rgba(69,115,81,.62), transparent 33%), radial-gradient(ellipse at 55% 120%, rgba(35,102,72,.5), transparent 42%), linear-gradient(117deg, #12382c 0%, #174431 55%, #1b4a35 100%); padding: 32px 37px 24px; color: #fff; position: relative; box-shadow: 0 9px 27px rgba(24,64,44,.12); }
.hero-left { width: 57%; position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; }
.hero-eyebrow { display: flex; align-items: center; gap: 7px; color: #aecbb6; font-size: 8px; font-weight: 800; letter-spacing: .14em; margin-bottom: 13px; }
.hero-pulse { width: 6px; height: 6px; border-radius: 50%; background: #b6e6b8; box-shadow: 0 0 0 4px rgba(181,228,183,.1); }
.dashboard-hero h1 { font-family: 'Manrope', sans-serif; font-size: clamp(30px, 3.1vw, 42px); line-height: 1.05; letter-spacing: -.055em; color: #f6fbf5; margin: 0 0 13px; font-weight: 800; }
.dashboard-hero h1 em { font-style: normal; color: #b8e7bf; }
.dashboard-hero .hero-left > p { color: #c0d7c7; max-width: 385px; line-height: 1.7; font-size: 11px; margin: 0 0 19px; }
.hero-actions { display: flex; gap: 18px; align-items: center; }
.hero-actions .btn { padding: 10px 13px; font-size: 10px; }
.hero-link-button { display: inline-flex; align-items: center; gap: 5px; padding: 8px 0; border: 0; background: transparent; color: #d0e5d4; font-size: 10px; font-weight: 700; }
.hero-link-button:hover { color: #fff; }
.hero-footnote { display: flex; gap: 6px; align-items: center; margin-top: auto; padding-top: 17px; font-size: 9px; color: #99bda5; }
.hero-footnote svg { color: #b7d9bf; }
.hero-right { position: absolute; right: 5.8%; top: 0; bottom: 0; width: 39%; overflow: hidden; min-width: 280px; }
.hero-decor { position: absolute; border-radius: 50%; border: 1px solid rgba(192,226,198,.08); pointer-events: none; }
.hero-decor-one { width: 330px; height: 330px; right: -170px; bottom: -225px; }
.hero-decor-two { width: 250px; height: 250px; right: 27%; top: -170px; }
.orbit { border-radius: 50%; border: 1px solid rgba(201,235,204,.15); position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); }
.orbit-one { width: 230px; height: 230px; }
.orbit-two { width: 167px; height: 167px; border-style: dashed; border-color: rgba(191,228,197,.18); }
.hero-core { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 116px; height: 116px; border-radius: 50%; border: 1px solid rgba(205,236,206,.36); background: radial-gradient(circle at 28% 17%, rgba(155,218,165,.2), transparent 65%), rgba(203,236,205,.065); display: flex; flex-direction: column; gap: 7px; align-items: center; justify-content: center; color: #d6f1d7; box-shadow: 0 0 40px rgba(143,207,155,.07), inset 0 0 22px rgba(255,255,255,.025); backdrop-filter: blur(4px); }
.hero-core span { font-size: 7px; font-weight: 800; letter-spacing: .16em; text-align: center; line-height: 1.45; }
.float-chip { position: absolute; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 9px; background: rgba(238,249,238,.96); box-shadow: 0 7px 22px rgba(3,31,19,.17); color: #305b3f; z-index: 2; white-space: nowrap; }
.float-chip-one { top: 15%; left: 0; }
.float-chip-two { right: -3%; bottom: 16%; }
.float-chip-icon { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px; background: #e0f0e3; color: #4f9366; }
.leaf-float { background: #dbefe0; }
.float-chip > span:last-child { display: flex; flex-direction: column; gap: 2px; }
.float-chip strong { color: #1f5135; font-size: 11px; line-height: 1.1; }
.float-chip small { color: #829486; font-size: 8px; }
.orbit-node { position: absolute; width: 33px; height: 33px; border-radius: 11px; display: grid; place-items: center; background: rgba(201,236,204,.13); border: 1px solid rgba(210,238,211,.27); color: #c6e9c9; }
.node-one { top: 24%; right: 20%; transform: rotate(8deg); }
.node-two { bottom: 21%; left: 16%; transform: rotate(-9deg); }
.demo-data-notice { display: flex; align-items: center; gap: 10px; color: #7e6d99; background: #f5f1fb; border: 1px solid #ebe3f5; border-radius: 8px; padding: 9px 12px; font-size: 10px; line-height: 1.5; }
.demo-tag { background: #e8def6; color: #7251a0; font-weight: 800; font-size: 8px; letter-spacing: .08em; padding: 4px 6px; border-radius: 5px; white-space: nowrap; }
.section-topline { display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; margin: 3px 0 -3px; }
.section-topline .eyebrow { margin-bottom: 5px; }
.section-topline h2 { font-family: 'Manrope', sans-serif; font-size: 16px; font-weight: 800; letter-spacing: -.035em; margin: 0; color: #2d4435; }
.last-updated { display: flex; align-items: center; gap: 7px; color: #94a097; font-size: 9px; white-space: nowrap; }
.last-updated span { width: 5px; height: 5px; }
.metric-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 13px; }
.metric-card { background: #fff; border: 1px solid #e8ece7; border-radius: 12px; min-width: 0; min-height: 130px; padding: 15px 16px 14px; position: relative; box-shadow: 0 3px 15px rgba(37,61,45,.025); }
.metric-icon { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; margin-bottom: 13px; }
.metric-forest { background: #e6f2e8; color: #3a8054; }
.metric-mint { background: #e7f5ea; color: #3d8c60; }
.metric-blue { background: #e9f3f8; color: #4c85a1; }
.metric-amber { background: #fcf1df; color: #b17a32; }
.metric-top-line { position: absolute; left: 61px; right: 12px; top: 20px; display: flex; justify-content: space-between; align-items: center; gap: 4px; }
.metric-top-line > span:first-child { color: #637469; font-size: 10px; font-weight: 700; }
.metric-chip { font-size: 7px; color: #9aa69d; background: #f4f6f3; padding: 4px 5px; border-radius: 5px; white-space: nowrap; }
