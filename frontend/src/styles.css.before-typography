  .impact-events-card > .card-heading-row { padding: 0 15px 13px; }
  .impact-research-note { align-items: flex-start; flex-wrap: wrap; padding: 12px; }
  .impact-research-note button { margin-left: 24px; }
  .assistant-layout { grid-template-columns: 1fr; }
  .assistant-main { padding: 16px; }
  .assistant-welcome { gap: 10px; }
  .assistant-bot-orb { width: 43px; height: 43px; border-radius: 13px; }
  .assistant-welcome h2 { font-size: 15px; }
  .assistant-welcome p { font-size: 9px; }
  .assistant-submit-row { align-items: flex-start; flex-direction: column; }
  .assistant-submit-row .btn { align-self: flex-end; }
  .assistant-side { display: grid; grid-template-columns: 1fr 1fr; }
  .assistant-principle-card { grid-column: 1 / -1; }
  .assistant-safety-card, .assistant-side-link { min-width: 0; }
  .assistant-side-link { grid-column: 1 / -1; }
  .history-overview-row { gap: 8px; }
  .history-overview-card { grid-template-columns: 1fr; gap: 6px; padding: 12px; }
  .history-overview-icon { grid-row: auto; width: 30px; height: 30px; }
  .history-overview-card > span:nth-child(2) { font-size: 8px; }
  .history-overview-card strong { font-size: 18px; }
  .history-overview-card small { font-size: 7px; line-height: 1.4; }
  .history-toolbar { align-items: flex-start; flex-direction: column; padding: 14px; }
  .history-controls { width: 100%; flex-wrap: wrap; }
  .history-search { width: 100%; }
  .build-record { grid-template-columns: 32px minmax(0,1fr); gap: 9px; padding: 14px; }
  .build-record-mark { width: 31px; height: 31px; }
  .build-record-impact { grid-column: 2; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; border-left: 0; border-top: 1px solid #eef1ec; padding: 10px 0 0; margin-top: 4px; }
  .build-record-impact strong { margin: 0 0 3px; }
  .api-error-banner { flex-wrap: wrap; padding: 10px; }
  .api-error-banner div { min-width: calc(100% - 35px); }
  .api-error-banner button { margin-left: 27px; }
}
@media (max-width: 430px) {
  .app-content { padding-left: 10px; padding-right: 10px; }
  .app-topbar { padding: 0 10px; }
  .app-footer { padding-left: 10px; padding-right: 10px; }
  .topbar-icon-button { display: none; }
  .page-intro-row h1 { font-size: 21px; }
  .dashboard-hero { padding: 20px 16px; }
  .dashboard-hero h1 { font-size: 31px; }
  .hero-right { height: 145px; }
  .float-chip { padding: 6px 7px; gap: 6px; }
  .float-chip-icon { width: 23px; height: 23px; }
  .float-chip strong { font-size: 9px; }
  .float-chip small { font-size: 7px; }
  .recommendation-item { gap: 7px; }
  .recommendation-icon { width: 31px; height: 31px; }
  .recommendation-score { width: 55px; }
  .recommendation-title-line strong { font-size: 9px; }
  .recommendation-copy p { font-size: 8px; }
  .recommendation-chevron { display: none; }
  .inventory-grid { grid-template-columns: 1fr; }
  .inventory-item-card { padding: 13px; }
  .inventory-item-card h3 { font-size: 11px; }
  .plan-impact-row { grid-template-columns: 1fr; }
  .mini-impact-card { flex-direction: row; align-items: center; }
  .mini-impact-card span { min-height: 0; }
  .impact-chart-foot { align-items: flex-start; flex-direction: column; }
  .assistant-side { grid-template-columns: 1fr; }
  .assistant-principle-card, .assistant-side-link { grid-column: auto; }
  .history-overview-card { padding: 10px; }
  .history-overview-card strong { font-size: 16px; }
  .complete-build-copy { min-width: 0; }
  .modal-heading { padding: 17px; }
  .component-form { padding: 15px 17px 20px; }
  .modal-footer-custom { align-items: flex-start; }
  .form-footnote { max-width: 100%; }
}
.export-button { text-decoration: none; white-space: nowrap; }
.impact-events-actions { display: flex; align-items: center; gap: 8px; }
.impact-events-actions .btn { white-space: nowrap; }
@media (max-width: 780px) {
  .inventory-filters .export-button { padding: 6px 7px; gap: 4px; font-size: 8px; }
  .impact-events-actions { flex-wrap: wrap; justify-content: flex-end; }
}
