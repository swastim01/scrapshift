# Optional. Core SCRAPSHIFT features work without an AI key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Default database path is backend/data/scrapshift.db. Override if desired.
# SCRAPSHIFT_DB_PATH=./data/scrapshift.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave enabled only for a local development workspace. Production disables reset by default.
SCRAPSHIFT_ENABLE_DEMO_RESET=true
